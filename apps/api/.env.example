# Optional; default is 3001.
PORT=3001

# Select one provider. Keep this file as an example; copy it to .env.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-installed-model
# Or use OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-chosen-model

# Optional request deadline in milliseconds; default is 60000.
MODEL_TIMEOUT_MS=60000
