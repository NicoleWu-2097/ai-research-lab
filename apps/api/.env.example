# Optional; default is 3001.
PORT=3001

# Select one provider. Keep this file as an example; copy it to .env.
LLM_PROVIDER=openai
# Optional local path: run Ollama and uncomment these two lines.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=your-installed-model
# Or use OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-chosen-model

# Optional request deadline in milliseconds; default is 60000.
MODEL_TIMEOUT_MS=60000

# Read-only MCP document tools (default root: repository docs/decisions).
MCP_ENABLED=true
# Relative paths resolve from apps/api when using pnpm dev.
# MCP_DOCUMENT_ROOT=/absolute/path/to/trusted-research-notes

# Enable indexed local retrieval for M6 (or the fixed pipeline in M5 mode).
RAG_ENABLED=false
# M6 routing + evidence assessment (default true). Set false for the M5 fixed pipeline.
AGENTIC_RAG_ENABLED=true
# M7 review and one revision (default true); requires AGENTIC_RAG_ENABLED=true.
MULTI_AGENT_ENABLED=true
DATABASE_URL=postgresql://research:local-research@localhost:5432/research
# External PostgreSQL: replace DATABASE_URL and enable certificate validation.
# DATABASE_SSL_MODE=verify-full
# Optional provider CA bundle (absolute path recommended):
# DATABASE_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
# Omit DATABASE_SSL_MODE when using TLS parameters inside DATABASE_URL.
# Defaults to repository docs/decisions. Same file restrictions as MCP.
# RAG_DOCUMENT_ROOT=/absolute/path/to/trusted-research-notes
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
# Required by voyage and jina. OpenAI uses OPENAI_API_KEY instead.
EMBEDDING_API_KEY=
# Optional; each provider has a default endpoint:
# voyage https://api.voyageai.com/v1, jina https://api.jina.ai/v1,
# openai https://api.openai.com/v1, ollama http://localhost:11434.
# EMBEDDING_BASE_URL=
# Optional local path: run Ollama and uncomment this block.
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=embeddinggemma
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_BASE_URL=http://localhost:11434
# RAG_MIN_SCORE=0.4

# M8: explicit opt-in; start both role services before enabling.
A2A_ENABLED=false
A2A_RESEARCHER_URL=http://127.0.0.1:4101
A2A_CRITIC_URL=http://127.0.0.1:4102
# Per-role process only: A2A_PORT overrides 4101/4102.
# Each process may independently override LLM_PROVIDER/model/MODEL_TIMEOUT_MS.

# M9 full research loop (requires Agentic RAG + multi-agent; default true).
# Set false to use M7/M8 bounded review without new research after Critic.
RESEARCH_LOOP_ENABLED=true

# M10: durable human approval; requires PostgreSQL and the M9 loop.
HUMAN_ENABLED=true
APPROVAL_TIMEOUT_MS=86400000

# Brave Search LLM Context API (https://api-dashboard.search.brave.com/api-reference/ai/llm_context/get)
WEB_SEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://hkust.azure-api.net/hkust-genai/v1
OPENAI_API_STYLE=chat-completions
OPENAI_AUTH_HEADER=api-key
