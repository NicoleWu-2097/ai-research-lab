# Optional; default is 3001.
PORT=3001

# Select one provider. Keep this file as an example; copy it to .env.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-installed-model
# Or use OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-chosen-model

# Optional request deadline in milliseconds; default is 60000.
MODEL_TIMEOUT_MS=60000

# Read-only MCP document tools (default root: repository docs/decisions).
MCP_ENABLED=true
# Relative paths resolve from apps/api when using pnpm dev.
# MCP_DOCUMENT_ROOT=/absolute/path/to/trusted-research-notes

# Enable the fixed local RAG pipeline instead of MCP document selection.
RAG_ENABLED=false
DATABASE_URL=postgresql://research:local-research@localhost:5432/research
# External PostgreSQL: replace DATABASE_URL and enable certificate validation.
# DATABASE_SSL_MODE=verify-full
# Optional provider CA bundle (absolute path recommended):
# DATABASE_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
# Omit DATABASE_SSL_MODE when using TLS parameters inside DATABASE_URL.
# Defaults to repository docs/decisions. Same file restrictions as MCP.
# RAG_DOCUMENT_ROOT=/absolute/path/to/trusted-research-notes
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
# Independent from OLLAMA_BASE_URL; defaults to localhost:11434 for Ollama.
# EMBEDDING_BASE_URL=http://localhost:11434
# OpenAI uses OPENAI_API_KEY and the selected embedding model's native dimension.
# RAG_MIN_SCORE=0.4
